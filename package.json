{
  "name": "stackforge-mcp",
  "version": "0.1.0",
  "private": false,
  "description": "StackForge MCP server for recommending AI architecture recipes with remote-first data sync.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "architecture",
    "deepseek",
    "ollama"
  ],
  "bin": {
    "stackforge-mcp": "./bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "data",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "kb:update": "tsx scripts/update-kb.ts",
    "e2e": "playwright test",
    "build:mcp": "tsc --project tsconfig.mcp.json",
    "mcp:smoke": "node scripts/smoke-mcp.cjs",
    "prepack": "pnpm build:mcp"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.54",
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@ai-sdk/react": "^4.0.121",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.118",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "wrangler": "4.144.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd",
      "esbuild"
    ]
  }
}
