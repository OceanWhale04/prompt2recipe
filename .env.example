# Server-side DeepSeek is used only for requests that do not include a browser provider config.
# The UI defaults to Experience mode; BYOK and Ollama are sent per request from localStorage.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional placeholders reserved for the weekly automation pipeline.
OPENROUTER_API_KEY=
GITHUB_TOKEN=
RSS_FEEDS=
