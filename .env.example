# Server-side DeepSeek is used only for requests that do not include a browser provider config.
# The UI defaults to Experience mode; BYOK and Ollama are sent per request from localStorage.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Weekly report pipeline: cloud DeepSeek by default; set WEEKLY_AI_PROVIDER=ollama
# only when intentionally using a local model.
WEEKLY_AI_PROVIDER=deepseek
WEEKLY_TIME_ZONE=Asia/Shanghai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional data source configuration for the weekly automation pipeline.
OPENROUTER_API_KEY=
GITHUB_TOKEN=
RSS_FEEDS=
RSS_FEEDS=
